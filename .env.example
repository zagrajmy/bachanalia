# The real values come from `vercel env pull .env.local` — this file only
# documents the shape for contributors without Vercel access. The apex is this
# app; WordPress answers on wp.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WORDPRESS_API_URL=https://wp.bachanaliafantastyczne.pl
NEXT_PUBLIC_WORDPRESS_API_HOSTNAME=wp.bachanaliafantastyczne.pl
# What WordPress signs its revalidation webhook with — the api/revalidate
# route rejects anything else. Nothing else reads it, so dev, build and the
# mocked e2e suite all run on the three public vars alone.
HEADLESS_SECRET=
