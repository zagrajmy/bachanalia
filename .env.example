# The real values come from `vercel env pull .env.local` — this file only
# documents the shape for contributors without Vercel access. Since the
# cutover the apex is this app; WordPress answers on wp.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WORDPRESS_API_URL=https://wp.bachanaliafantastyczne.pl
NEXT_PUBLIC_WORDPRESS_API_HOSTNAME=wp.bachanaliafantastyczne.pl
# Only `bun run dev` / `build` against the live WordPress need this; the
# mocked e2e suite runs on the three public vars alone.
HEADLESS_SECRET=
