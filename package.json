{
  "name": "bachanalia",
  "private": true,
  "scripts": {
    "dev": "bun run codegen && next dev",
    "build": "bun run codegen && next build",
    "start": "next start",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "codegen": "graphql-codegen --config codegen.ts && node ./add-ts-nocheck.js",
    "codegen:refresh": "WP_SCHEMA_REFRESH=1 bun run codegen",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "bun test src next.config.test.ts",
    "e2e:build": "bun run build && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "lucide-react": "1.28.0",
    "next": "^16.2.9",
    "radix-ui": "1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/client-preset": "4.3.3",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@hasparus/oxlint-config": "^0.1.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "globals": "17.8.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "tailwindcss": "^4",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  }
}
