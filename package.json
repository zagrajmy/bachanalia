{
  "name": "bachanalia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run codegen && next dev",
    "build": "bun run codegen && bun run lqip && bun run exhibitor-logos && next build",
    "start": "next start",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "codegen": "graphql-codegen --config codegen.ts && node ./add-ts-nocheck.js",
    "codegen:refresh": "WP_SCHEMA_REFRESH=1 bun run codegen",
    "lqip": "bun scripts/lqip-cache.ts",
    "archive-news": "bun scripts/archive-fb-news.ts",
    "e2e": "playwright test",
    "e2e:server": "MOCK_WP=replay NEXT_DIST_DIR=.next-mock next dev",
    "e2e:record": "bun scripts/record-wp.ts",
    "e2e:ui": "playwright test --ui",
    "test": "bun test src next.config.test.ts",
    "e2e:build": "bun run build && playwright test",
    "exhibitor-logos": "bun scripts/exhibitor-logos.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "next": "16.3.0",
    "radix-ui": "1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/client-preset": "4.3.3",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@hasparus/oxlint-config": "^0.2.0",
    "@hasparus/tailwind": "1.1.8",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "globals": "17.8.0",
    "msw": "2.15.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "tailwindcss": "^4",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  }
}
